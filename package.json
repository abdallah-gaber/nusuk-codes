{
  "name": "nusuk-codes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "snapshot": "admin/.venv/bin/python -m admin.cli snapshot",
    "admin": "admin/.venv/bin/python -m admin.cli",
    "validate:csv": "python3 -m admin.cli validate",
    "test:admin": "python3 -m unittest admin.tests.test_pipeline admin.tests.test_publication admin.tests.test_incremental -v",
    "lint:admin": "admin/.venv/bin/ruff check admin scripts",
    "test:emulator": "npm exec --yes --package firebase-tools@15.1.0 -- firebase emulators:exec --project demo-nusuk-codes --only firestore \"admin/.venv/bin/python -m unittest admin.tests.test_emulator -v\"",
    "snapshot:preview": "python3 scripts/build_snapshot.py",
    "ingest": "admin/.venv/bin/python -m admin.cli import",
    "codes:update": "admin/.venv/bin/python -m admin.update",
    "codes:verify-live": "admin/.venv/bin/python -m admin.check_cdn"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
