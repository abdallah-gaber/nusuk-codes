# Frontend: no environment variables, Firebase config, SDK or credentials needed.
# Admin only (never prefix credentials with VITE_):
# NUSUK_FIREBASE_CREDENTIALS_JSON=<service account JSON supplied in a private shell only>
# Alternative explicit ADC path (outside checkout):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/checkout/admin-credentials.json
# NUSUK_ENABLE_PRODUCTION=nusuk-codes
# NUSUK_ADMIN_ACTOR=owner-or-moderator-label
# Optional keyless access from an existing approved ADC store (tokens stay in RAM):
# NUSUK_IMPERSONATE_SERVICE_ACCOUNT=nusuk-codes-reader@nusuk-codes.iam.gserviceaccount.com
# Emulator only; unset before production commands:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
